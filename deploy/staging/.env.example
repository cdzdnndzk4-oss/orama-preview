# Keep the real deploy/staging/.env only on the staging host. Never commit it.
STAGING_HOST=staging-host-owned-by-you.example
STAGING_BASIC_USER=owner
STAGING_BASIC_HASH='GENERATE_WITH_CADDY_HASH_PASSWORD'
POSTGRES_PASSWORD=RANDOM_POSTGRES_PASSWORD
# URL-encode reserved characters in this password component.
DATABASE_URL=postgresql+psycopg://orama:RANDOM_POSTGRES_PASSWORD@postgres:5432/orama
MINIO_ROOT_USER=RANDOM_ACCESS_KEY
MINIO_ROOT_PASSWORD=RANDOM_LONG_SECRET
